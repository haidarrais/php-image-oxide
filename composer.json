{
    "name": "haidarrais/image-oxide",
    "description": "PHP client for the image-oxide daemon with a GD fallback driver. Speaks the 001 wire protocol.",
    "type": "library",
    "keywords": ["image", "resize", "gd", "daemon", "oxide", "webp", "avif"],
    "license": "MIT",
    "authors": [
        {
            "name": "Haidar Rais"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-gd": "*",
        "ext-sockets": "*",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "ImageOxide\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ImageOxide\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
